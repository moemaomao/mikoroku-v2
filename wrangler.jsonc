{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikoroku-v2",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mikoroku-v2"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "4cf3f06d81e544e4ac88eb261d936cd7",
      "preview_id": "4cf3f06d81e544e4ac88eb261d936cd7"
    },
    {
      "binding": "MIKOROKU_V2_CACHE",
      "id": "4cf3f06d81e544e4ac88eb261d936cd7",
      "preview_id": "4cf3f06d81e544e4ac88eb261d936cd7"
    }
  ],
  "triggers": {
    "crons": ["*/20 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
