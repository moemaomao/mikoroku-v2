{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rokuyomu",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-12-23",
	"compatibility_flags": [
		"nodejs_als",
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}